<?xml version="1.0" encoding="utf-8"?>
<!--
  Woven harvest basket, shown beside the Dino on the Daily Harvest screen.

  Ported from the basket block in Prototype/daily-harvest.html, which is built from a
  domed body, a gold handle arch with rounded shoulders, and weave lines across the body.
  The previous version was a plain brown rounded square, which read as an empty box rather
  than a basket.

  The handle is drawn as a FILLED arch rather than a stroked line: a fill renders
  identically everywhere and cannot be lost to a missing stroke width.

  The weave is a light cross pattern rather than a dark grid - the prototype's weave is
  30 percent black over a brown body, but at this small size a dark grid reads as a cage.
  Warm highlights suggest woven cane without fighting the fruit sitting on top.

  Drawn as vector art so it stays crisp at any size and needs no bitmap density folders.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="52dp"
    android:viewportWidth="16"
    android:viewportHeight="17">

    <!-- Handle: filled arch, outer edge then the inner cut-out -->
    <path
        android:fillColor="@color/basket_handle"
        android:pathData="M3.7,5.4 L3.7,4.1 A2.8,2.8 0 0 1 6.5,1.3 L9.5,1.3 A2.8,2.8 0 0 1 12.3,4.1 L12.3,5.4 L11.1,5.4 L11.1,4.1 A1.6,1.6 0 0 0 9.5,2.5 L6.5,2.5 A1.6,1.6 0 0 0 4.9,4.1 L4.9,5.4 Z" />

    <!-- Basket body: domed at the bottom, square at the rim -->
    <path
        android:fillColor="@color/basket_body"
        android:pathData="M2.6,5.2 h10.8 a1,1 0 0 1 1,1 v6 a2.6,2.6 0 0 1 -2.6,2.6 h-7.6 a2.6,2.6 0 0 1 -2.6,-2.6 v-6 a1,1 0 0 1 1,-1 Z" />

    <!-- Woven cane bands -->
    <path android:fillColor="@color/basket_weave" android:pathData="M3.9,9.2 h8.2 v0.35 h-8.2 Z" />
    <path android:fillColor="@color/basket_weave" android:pathData="M3.9,10.6 h8.2 v0.35 h-8.2 Z" />
    <path android:fillColor="@color/basket_weave" android:pathData="M6.6,6.6 h0.35 v2.4 h-0.35 Z" />
    <path android:fillColor="@color/basket_weave" android:pathData="M9.1,6.6 h0.35 v2.4 h-0.35 Z" />
    <path android:fillColor="@color/basket_weave" android:pathData="M5.2,9.8 h0.35 v2.2 h-0.35 Z" />
    <path android:fillColor="@color/basket_weave" android:pathData="M7.8,9.8 h0.35 v2.2 h-0.35 Z" />
    <path android:fillColor="@color/basket_weave" android:pathData="M10.4,9.8 h0.35 v2.2 h-0.35 Z" />

    <!-- Rim band across the top, drawn last so it sits over the weave -->
    <path
        android:fillColor="@color/basket_rim"
        android:pathData="M2.6,5.2 h10.8 a1,1 0 0 1 1,1 v1.2 h-12.8 v-1.2 a1,1 0 0 1 1,-1 Z" />
</vector>
