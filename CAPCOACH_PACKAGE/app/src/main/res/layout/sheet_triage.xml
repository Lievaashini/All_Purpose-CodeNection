<?xml version="1.0" encoding="utf-8"?>
<!--
  Triage bottom sheet (port of the #triageModal block in dashboard.html).

  Shown by DashboardFragment's Rebalance button as a BottomSheetDialogFragment.
  It is a read-only preview of what the on-device model proposes: the two impact
  metrics, then four modification rows, one per outcome the optimiser can pick
  (protected, kept, postponed, deferred).

  Accepting it dismisses the sheet and fires the host fragment's
  OnRebalanceAccepted callback, which is what makes the dashboard show its
  "Schedule Rebalanced" toast.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/gutter"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_lg">

        <!-- Drag handle -->
        <View
            android:layout_width="48dp"
            android:layout_height="6dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_drag_handle" />

        <!-- ============ Header ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_zone_pill">

                <ImageView
                    android:id="@+id/triageDino"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/dino_description" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.MicroLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/triage_eyebrow"
                    android:textColor="@color/brand_mint"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/triage_title" />
            </LinearLayout>

            <ImageView
                android:id="@+id/triageClose"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/cd_close_modal"
                android:focusable="true"
                android:padding="@dimen/space_md"
                android:src="@drawable/ic_close"
                app:tint="@color/text_muted_dark" />
        </LinearLayout>

        <!-- ============ Impact metrics ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_surface_low"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    style="@style/Text.MicroLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/triage_metric_load" />

                <TextView
                    style="@style/Text.Metric"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/triage_metric_load_value"
                    android:textColor="@color/brand_mint" />

                <TextView
                    style="@style/Text.MicroLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/triage_metric_load_sub"
                    android:textColor="@color/text_muted_dark" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_surface_low"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    style="@style/Text.MicroLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/triage_metric_sleep" />

                <TextView
                    style="@style/Text.Metric"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/triage_metric_sleep_value"
                    android:textColor="@color/secondary_blue" />

                <TextView
                    style="@style/Text.MicroLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/triage_metric_sleep_sub"
                    android:textColor="@color/text_muted_dark" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ Proposed plan ============ -->
        <TextView
            style="@style/Text.MicroLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/triage_plan_label" />

        <!-- Row 1: protected shift -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_surface_low"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/task_accent_width"
                android:layout_height="match_parent"
                android:background="@drawable/bg_accent_blue" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_sm">

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/triage_item_protected_title"
                    android:textColor="@color/text_primary_dark"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Text.MicroLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/triage_item_protected_sub" />
            </LinearLayout>

            <TextView
                style="@style/Text.MicroLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:background="@drawable/bg_tag_blue"
                android:paddingHorizontal="@dimen/space_sm"
                android:paddingVertical="2dp"
                android:text="@string/triage_tag_protected"
                android:textColor="@color/secondary_blue"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2: academic priority kept -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_surface_low"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/task_accent_width"
                android:layout_height="match_parent"
                android:background="@drawable/bg_accent_mint" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_sm">

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/triage_item_kept_title"
                    android:textColor="@color/text_primary_dark"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Text.MicroLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/triage_item_kept_sub" />
            </LinearLayout>

            <TextView
                style="@style/Text.MicroLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:background="@drawable/bg_tag_mint"
                android:paddingHorizontal="@dimen/space_sm"
                android:paddingVertical="2dp"
                android:text="@string/triage_tag_kept"
                android:textColor="@color/brand_mint"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 3: postponed item -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_surface_low"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/task_accent_width"
                android:layout_height="match_parent"
                android:background="@drawable/bg_accent_amber" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_sm">

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/triage_item_postponed_title"
                    android:textColor="@color/text_primary_dark"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Text.MicroLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/triage_item_postponed_sub" />
            </LinearLayout>

            <TextView
                style="@style/Text.MicroLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:background="@drawable/bg_tag_amber"
                android:paddingHorizontal="@dimen/space_sm"
                android:paddingVertical="2dp"
                android:text="@string/triage_tag_postponed"
                android:textColor="@color/accent_amber"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 4: deferred low-yield chore -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_surface_low"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/task_accent_width"
                android:layout_height="match_parent"
                android:background="@drawable/bg_accent_slate" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_sm">

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/triage_item_deferred_title"
                    android:textColor="@color/text_primary_dark"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Text.MicroLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/triage_item_deferred_sub" />
            </LinearLayout>

            <TextView
                style="@style/Text.MicroLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:background="@drawable/bg_task_tag"
                android:paddingHorizontal="@dimen/space_sm"
                android:paddingVertical="2dp"
                android:text="@string/triage_tag_deferred"
                android:textColor="@color/text_muted_dark"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ============ Actions ============ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/triageAccept"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/triage_accept"
            app:icon="@drawable/ic_done_all"
            app:iconTint="@color/on_brand" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/triageDismiss"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/triage_dismiss"
            android:textColor="@color/text_muted_dark" />
    </LinearLayout>

</androidx.core.widget.NestedScrollView>

