<?xml version="1.0" encoding="utf-8"?>
<!--
  Triage bottom sheet (port of the #triageModal block in dashboard.html).

  Shown by DashboardFragment's Rebalance button as a BottomSheetDialogFragment.
  It shows what the on-device model proposes for the selected day: two measured
  metrics (load taken off the day, recovery debt), then one row per real task,
  tagged with one of the planner's three outcomes (protected, kept, postponed).

  Accepting it fires the host fragment's OnRebalanceAccepted callback, which saves
  each moved task's new date and only then shows the "Schedule Rebalanced" toast.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/gutter"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_lg">

        <!-- Drag handle -->
        <View
            android:layout_width="48dp"
            android:layout_height="6dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_drag_handle" />

        <!-- ============ Header ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_zone_pill">

                <ImageView
                    android:id="@+id/triageDino"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/dino_description" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.MicroLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/triage_eyebrow"
                    android:textColor="@color/brand_mint"
                    android:textStyle="bold" />

                <!-- Prose on this sheet is written per coaching tone by
                     TriageSheetFragment.bindToneCopy(); these are design-time values. -->
                <TextView
                    android:id="@+id/triageTitle"
                    style="@style/Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Overload Prevention Action" />
            </LinearLayout>

            <ImageView
                android:id="@+id/triageClose"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/cd_close_modal"
                android:focusable="true"
                android:padding="@dimen/space_md"
                android:src="@drawable/ic_close"
                app:tint="@color/text_muted_dark" />
        </LinearLayout>

        <!-- ============ Impact metrics ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_surface_low"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    style="@style/Text.MicroLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/triage_metric_load" />

                <!-- Bound at runtime to the load this plan actually removes. -->
                <TextView
                    android:id="@+id/triageMetricLoadValue"
                    style="@style/Text.Metric"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/brand_mint"
                    tools:text="-23%" />

                <TextView
                    android:id="@+id/triageMetricLoadSub"
                    style="@style/Text.MicroLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted_dark"
                    tools:text="Crash risk drops to 0%" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_surface_low"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    style="@style/Text.MicroLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/triage_metric_debt" />

                <!-- Bound at runtime to the recovery debt the model was given. -->
                <TextView
                    android:id="@+id/triageMetricDebtValue"
                    style="@style/Text.Metric"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/secondary_blue"
                    tools:text="72/100" />

                <TextView
                    android:id="@+id/triageMetricSleepSub"
                    style="@style/Text.MicroLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted_dark"
                    tools:text="Recovery window locked" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ Proposed plan ============ -->
        <TextView
            style="@style/Text.MicroLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/triage_plan_label" />

        <!-- ============ Proposed plan rows ============ -->
        <!--
          Filled at runtime by TriageSheetFragment, one row per real task on the
          selected day. These used to be four hardcoded rows naming tasks the user
          did not have; the model now decides what goes here.
        -->
        <LinearLayout
            android:id="@+id/triagePlanList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Shown instead of the rows when the day is calm or genuinely empty. -->
        <TextView
            android:id="@+id/triageEmptyState"
            style="@style/Text.MicroLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_surface_low"
            android:padding="@dimen/space_md"
            android:visibility="gone"
            tools:text="Today is under control - nothing needs moving."
            tools:visibility="visible" />

        <!-- ============ Actions ============ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/triageAccept"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:icon="@drawable/ic_done_all"
            app:iconTint="@color/on_brand"
            tools:text="Accept Rebalance &amp; Rest" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/triageDismiss"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textColor="@color/text_muted_dark"
            tools:text="Dismiss for Now" />
    </LinearLayout>

</androidx.core.widget.NestedScrollView>

