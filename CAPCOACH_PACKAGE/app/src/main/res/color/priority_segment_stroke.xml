<?xml version="1.0" encoding="utf-8"?>
<!--
  Outline colour for one segment of the priority selector (sheet_add_task.xml).
  The selected segment's outline matches its mint fill so the shape reads as one
  solid chip; the others keep the normal divider hairline.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/brand_mint" android:state_checked="true" />
    <item android:color="@color/divider_dark" />
</selector>
