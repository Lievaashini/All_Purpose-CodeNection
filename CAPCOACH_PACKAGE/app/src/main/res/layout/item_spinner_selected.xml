<?xml version="1.0" encoding="utf-8"?>
<!--
  Closed-state row for @id/categorySpinner in sheet_add_task.xml.

  A Spinner with no explicit item layout falls back to the framework's
  simple_spinner_item, whose default text colour is nearly invisible on the dark
  surface. This supplies the row instead. ArrayAdapter.getView() in
  AddTaskSheetFragment also paints the colour at runtime, so the two agree.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/touch_target_min"
    android:ellipsize="end"
    android:gravity="center_vertical"
    android:maxLines="1"
    android:textColor="@color/text_primary_dark"
    android:textSize="@dimen/text_body" />
