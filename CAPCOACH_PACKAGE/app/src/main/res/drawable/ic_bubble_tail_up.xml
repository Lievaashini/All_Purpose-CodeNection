<?xml version="1.0" encoding="utf-8"?>
<!--
  The speech-bubble tail: an upward-pointing triangle that ties the reaction bubble
  back to the Dino it is speaking from.

  Filled with the same @color/surface_container_high as bg_speech_bubble, and drawn
  behind the bubble's top edge so the two read as one shape. Because it is a colour
  reference rather than a literal, values-night/ recolours the tail with the bubble
  automatically - there is no second night asset to keep in sync.

  NEW FILE - additive. Nothing existing is modified.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="18dp"
    android:height="9dp"
    android:viewportWidth="18"
    android:viewportHeight="9">
    <path
        android:fillColor="@color/surface_container_high"
        android:pathData="M0,9 L9,0 L18,9 Z" />
</vector>