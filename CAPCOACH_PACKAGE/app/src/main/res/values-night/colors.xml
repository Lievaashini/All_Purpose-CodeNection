<?xml version="1.0" encoding="utf-8"?>
<!--
  DARK PALETTE  =  this file  (res/values-night/)

  The standard Android qualifier meaning applies: -night is used when the app is in
  night mode. ThemeController.bind() calls
  AppCompatDelegate.setDefaultNightMode(MODE_NIGHT_YES / MODE_NIGHT_NO), so
  MODE_NIGHT_YES loads this file and MODE_NIGHT_NO loads res/values/colors.xml.
  No manual view recolouring is needed.

  These two palettes previously lived in the opposite folders, which made every
  theme toggle land on the wrong colours. They have been swapped, so the qualifier
  now means what it says.

  ==========================================================================
  SOURCE OF TRUTH: the Tailwind config block in Prototype/onboarding.html.

  The prototype ships in DARK mode by default and its Sun/Moon toggle switches to
  bright, so the dark set is the one in that Tailwind block:

      background / surface          #121414
      surface-container-lowest      #0d0e0f
      surface-container-low         #1a1c1c
      surface-container             #1e2020
      surface-container-high        #292a2a
      surface-container-highest     #343535
      surface-bright                #383939
      on-surface                    #e3e2e2
      on-surface-variant            #bacbb9
      outline                       #859585
      outline-variant               #3b4a3d
  ==========================================================================

  BRAND COLOURS ARE DELIBERATELY UNCHANGED

  The prototype does NOT redefine its Tailwind palette in bright mode. It only
  overrides surfaces, text and borders. So the mint stays #00E676 in BOTH themes.
  That is intentional and is reproduced here.
-->
<resources>
    <!-- ============ Bright surfaces (from body.bright-mode) ============ -->
    <color name="bg_dark">#FF121414</color>                      <!-- app background -->
    <color name="surface_container_lowest">#FF0D0E0F</color>     <!-- inset surfaces -->
    <color name="surface_container_low">#FF1A1C1C</color>        <!-- cards -->
    <color name="surface_container">#FF1E2020</color>            <!-- card surface -->
    <color name="surface_container_high">#FF292A2A</color>       <!-- .header-phase-badge -->
    <color name="surface_container_highest">#FF343535</color>
    <color name="surface_bright">#FF383939</color>
    <color name="divider_dark">#FF343535</color>                 <!-- border colour used everywhere -->
    <color name="outline_dark">#FF3B4A3D</color>                 <!-- #theme-toggle-btn border -->
    <color name="outline_muted">#FF859585</color>                <!-- unchecked indicator glyph -->

    <!-- ============ Bright text ============ -->
    <color name="text_on_dark">#FFE3E2E2</color>
    <color name="text_primary_dark">#FFE3E2E2</color>            <!-- headings -->
    <color name="text_muted_dark">#FFBACBB9</color>              <!-- p / .theme-text-sub -->
    <color name="text_dim_dark">#FF859585</color>                <!-- .bottom-subtext -->
    <color name="text_outline_dark">#FF859585</color>

    <!-- ============ Brand, UNCHANGED from the dark palette ============ -->
    <!-- The prototype keeps its Tailwind colours in bright mode. Do not darken these. -->
    <color name="brand_mint">#FF00E676</color>
    <color name="brand_mint_light">#FF75FF9E</color>
    <color name="brand_mint_dark">#FF00C853</color>
    <color name="brand_mint_glow">#2E00E676</color>

    <color name="brand_blue">#FFB0C6FF</color>
    <color name="brand_blue_container">#FF0068ED</color>
    <color name="brand_gold">#FFFFE1A6</color>
    <color name="brand_gold_container">#FFFCBF01</color>

    <color name="brand_coral">#FFFFB4AB</color>
    <color name="brand_error_container">#FF93000A</color>

    <!-- ============ Semantic aliases ============ -->
    <!--
      .health-sub is #2563EB in bright mode (its own override), and the phase badge
      text is #047857. Those two are the only brand-family colours the prototype
      actually redefines, so they are aliased here.
    -->
    <color name="secondary_blue">@color/brand_blue</color>
    <color name="tertiary_gold_container">@color/brand_gold_container</color>

    <!--
      Status colours: the prototype has no bright overrides for these, so the values
      are darkened for legibility on the white card.
    -->
    <color name="status_green">#FF00E676</color>
    <color name="status_amber">#FFFCBF01</color>
    <color name="status_red">#FFFFB4AB</color>

    <color name="zone_safe_bg">#1F00E676</color>
    <color name="zone_elevated_bg">#1FFCBF01</color>
    <color name="zone_overload_bg">#1FFFB4AB</color>

    <!-- ============ Transparent helpers ============ -->
    <color name="transparent">#00000000</color>
    <color name="scrim">#99000000</color>

    <!-- ==================================================================
         ADDED FOR SCREENS 3-9 - bright values. Purely additive.

         Same rule as the brand colours above: the dashboard's amber and blue
         accents are NOT darkened in bright mode, only the surfaces flip.
         ================================================================== -->

    <!--
      Content drawn ON the mint brand colour. Identical in both palettes, because the
      mint behind it is identical in both palettes. See values/colors.xml for the note
      on why bg_dark must not be used for this job.
    -->
    <color name="on_brand">#FF003918</color>

    <color name="accent_amber">#FFF59E0B</color>
    <color name="accent_amber_bg">#1FF59E0B</color>

    <!-- Chart on a white card: slate tracks, amber heavy bar -->
    <color name="chart_bar_idle">#66CBD5E1</color>
    <color name="chart_bar_dim">#4DCBD5E1</color>
    <color name="chart_ceiling">#66EF4444</color>

    <color name="task_check_border">#FF64748B</color>

    <!-- Prototype uses #fff1f2 on #fecdd3 for the anomaly card -->
    <color name="anomaly_bg">#FF1E2020</color>
    <color name="metric_track_bg">#FF343535</color>

    <!-- Harvest / feast: daily-harvest.html bright mode is #F1F5F9 / #FFFFFF -->
    <color name="feast_canvas">#FF101212</color>
    <color name="feast_card">#FF171C1B</color>
    <color name="feast_basket">#FF8B5A2B</color>
    <color name="apple_red">#FFFF2A2A</color>
    <color name="apple_red_dark">#FFB30E0E</color>

    <color name="sheet_scrim">#BF000000</color>
</resources>


