<?xml version="1.0" encoding="utf-8"?>
<!--
  BRIGHT PALETTE  =  this file  (res/values/)
  DARK PALETTE    =  res/values-night/

  SOURCE OF TRUTH: Prototype/onboarding.html in the GitHub repo.

  The prototype defines its dark colours in the Tailwind config block, and its
  bright colours in the `body.bright-mode` CSS overrides, so both sets are ported
  here. This file holds the BRIGHT (default) set; res/values-night/ holds the dark
  one.

  This follows the standard Android qualifier meaning: `-night` applies when the
  device/app is in night mode. ThemeController switches palettes with
  AppCompatDelegate.setDefaultNightMode(MODE_NIGHT_YES / MODE_NIGHT_NO), so
  MODE_NIGHT_YES loads values-night/ (dark) and MODE_NIGHT_NO loads this file
  (bright). No manual view recolouring is needed.

  The two palettes previously lived in the opposite folders, which made every
  theme toggle land on the wrong colours. They are now swapped so the qualifier
  means what it says.

  Bright values below are copied from onboarding.html's `body.bright-mode` block.
-->
<resources>
    <!-- ============ Brand ============ -->
    <!-- Tailwind: primary-container -->
    <color name="brand_mint">#FF00E676</color>
    <!-- Tailwind: primary  (lighter mint, used for text/icons on dark) -->
    <color name="brand_mint_light">#FF75FF9E</color>
    <color name="brand_mint_dark">#FF00C853</color>
    <color name="brand_mint_glow">#2E00E676</color>

    <!-- Tailwind: secondary / secondary-container -->
    <color name="brand_blue">#FFB0C6FF</color>
    <color name="brand_blue_container">#FF0068ED</color>

    <!-- Tailwind: tertiary / tertiary-container -->
    <color name="brand_gold">#FFFFE1A6</color>
    <color name="brand_gold_container">#FFFCBF01</color>

    <!-- Tailwind: error -->
    <color name="brand_coral">#FFFFB4AB</color>
    <color name="brand_error_container">#FF93000A</color>

    <!-- ============ Dark surfaces (verbatim from tailwind.config) ============ -->
    <color name="bg_dark">#FFF8FAFC</color>                      <!-- app background -->
    <color name="surface_container_lowest">#FFF1F5F9</color>
    <color name="surface_container_low">#FFFFFFFF</color>
    <color name="surface_container">#FFFFFFFF</color>
    <color name="surface_container_high">#FFE2E8F0</color>
    <color name="surface_container_highest">#FFF1F5F9</color>
    <color name="surface_bright">#FFFFFFFF</color>
    <color name="divider_dark">#FFE2E8F0</color>                 <!-- surface-variant -->
    <color name="outline_dark">#FFCBD5E1</color>                 <!-- outline-variant -->
    <color name="outline_muted">#FF94A3B8</color>                <!-- outline -->

    <!-- ============ Dark text (verbatim from tailwind.config) ============ -->
    <color name="text_on_dark">#FF0F172A</color>                 <!-- on-surface -->
    <color name="text_primary_dark">#FF0F172A</color>
    <color name="text_muted_dark">#FF475569</color>              <!-- on-surface-variant -->
    <color name="text_dim_dark">#FF64748B</color>                <!-- outline -->
    <color name="text_outline_dark">#FF64748B</color>

    <!-- ============ Semantic aliases used by the layouts ============ -->
    <color name="secondary_blue">#FF2563EB</color>
    <color name="tertiary_gold_container">#FFB45309</color>

    <color name="status_green">#FF047857</color>
    <color name="status_amber">#FFB45309</color>
    <color name="status_red">#FFD83B01</color>

    <!-- Load-zone tints (low alpha) for banner backgrounds -->
    <color name="zone_safe_bg">#1F00E676</color>
    <color name="zone_elevated_bg">#1FFCBF01</color>
    <color name="zone_overload_bg">#1FFFB4AB</color>

    <!-- ============ Transparent helpers ============ -->
    <color name="transparent">#00000000</color>
    <color name="scrim">#99000000</color>

    <!-- ==================================================================
         ADDED FOR SCREENS 3-9 (dashboard, add-task, biometrics, harvest,
         feast, settings, companion). Purely additive - every token above is
         unchanged.

         Only genuinely new colour ROLES live here. Anything already covered
         by the tokens above (surfaces, text, mint/blue/gold, zone tints) is
         reused rather than redefined.
         ================================================================== -->

    <!--
      Content drawn ON the mint brand colour: button labels, chip labels, icon tints.

      This token exists because bg_dark was being used for that job. bg_dark is the app
      BACKGROUND, so it flips with the theme - which meant mint buttons read white-on-mint
      in bright mode. This colour is deliberately identical in both palettes, because the
      mint behind it is identical in both palettes.
    -->
    <color name="on_brand">#FF003918</color>

    <!-- Amber accent: weekly cap badge, heavy-load bar, postponed tag -->
    <color name="accent_amber">#FFF59E0B</color>
    <color name="accent_amber_bg">#1FF59E0B</color>

    <!-- Weekly load chart -->
    <color name="chart_bar_idle">#FFCBD5E1</color>
    <color name="chart_bar_dim">#FFE2E8F0</color>
    <color name="chart_ceiling">#FFEF4444</color>

    <!-- Task feed row -->
    <color name="task_check_border">#FF94A3B8</color>

    <!-- Biometrics -->
    <color name="anomaly_bg">#FFFFF1F2</color>
    <color name="metric_track_bg">#FFE2E8F0</color>

    <!-- Harvest / feast garden -->
    <color name="feast_canvas">#FFF1F5F9</color>
    <color name="feast_card">#FFFFFFFF</color>
    <color name="feast_basket">#FF8B5A2B</color>
    <color name="apple_red">#FFFF2A2A</color>
    <color name="apple_red_dark">#FFB30E0E</color>

    <!-- Bottom-sheet scrim, sits over the dimmed dashboard -->
    <color name="sheet_scrim">#B3000000</color>
</resources>

