<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  DINO QUOTES - HYPE tone
  ============================================================================

  One file per coaching tone: dino_hype.xml, dino_chill.xml, dino_plain.xml.
  Every file holds the SAME set of slot names, differing only in the tone suffix,
  so switching a line's voice means editing the matching slot in the matching
  file - and rewriting one character's whole personality means editing one file.

  The slot names are resolved by model/DinoVoice.java, which is the only thing
  that knows all three suffixes at once. Add a slot there and in all three files.

  Placeholder conventions, identical across the three tones:
    dino_work_safe_*        %1$d  weekly work hours the cap was set to
    dino_addtask_sched_*    %1$s  deferral window, %2$s priority label
    dino_harvest_apples_*   plural: %1$d apples that grew overnight

  These are the prototype's original strings: Hype is the default tone, so
  keeping its wording verbatim keeps the app looking as designed.
-->
<resources>

    <!-- Screen 1, the greeting shown when Hype is picked. -->
    <string name="dino_onboarding_hype">"Energetic sleep protector ready!"</string>

    <!-- Screen 2, the work-band guard reporting on the weekly shift cap. -->
    <string name="dino_work_safe_hype">"%1$dh cap locked. I\'ll auto-deflect exam week overruns!"</string>
    <string name="dino_work_caution_hype">"Careful! We are eating into deep recovery windows."</string>
    <string name="dino_work_risk_hype">"Red Alert! Demching Dino initiating emergency offloading!"</string>

    <!-- Daily Harvest, the bubble over the tree. -->
    <plurals name="dino_harvest_apples_hype">
        <item quantity="one">"1 ripe apple! Yum!"</item>
        <item quantity="other">"%1$d ripe apples! Yum!"</item>
    </plurals>

    <!-- Weekly Feast bubbles. -->
    <string name="dino_feast_hungry_hype">"Om nom! I\'m starving! Feed me!"</string>
    <string name="dino_feast_all_hype">"WHOAAAA! ALL OF THEM AT ONCE?! YES!"</string>
    <string name="dino_feast_hug_hype">"I love you! You preserved my rest this week!"</string>
    <string name="dino_feast_done_hype">"100% Satiated! Ready to crush Midterms!"</string>

    <!-- Weekly Feast idle chatter, picked at random while the tray is full. -->
    <string name="dino_feast_quote_1_hype">"CRUNCH! So sweet &amp; crunchy!"</string>
    <string name="dino_feast_quote_2_hype">"YUUUM! Midterm stress dissolved!"</string>
    <string name="dino_feast_quote_3_hype">"Nom nom! Protected sleep tastes good!"</string>
    <string name="dino_feast_quote_4_hype">"BURP! Best Sunday feast ever!"</string>
    <string name="dino_feast_quote_5_hype">"Full energy! Ready for next week!"</string>

    <!-- Add Task sheet, the line under the form. -->
    <string name="dino_addtask_guard_hype">"Locking shift. 0% chance of study-hall collisions."</string>
    <string name="dino_addtask_sched_hype">Shedding buffer: %1$s. Priority %2$s is held back from the shed list!</string>

</resources>
