<?xml version="1.0" encoding="utf-8"?>
<!--
  Host container for the CapCoach flow.

  Replaces the default "Hello World!" ConstraintLayout.

  KEEPS the original root id `@+id/main`, because MainActivity's edge-to-edge
  window-insets listener in this project attaches to it. The fragment container
  @+id/nav_host_container is what every screen gets swapped into.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <FrameLayout
        android:id="@+id/nav_host_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
