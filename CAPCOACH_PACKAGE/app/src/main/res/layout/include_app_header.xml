<?xml version="1.0" encoding="utf-8"?>
<!--
  SHARED TOP BAR for the three bottom-navigation screens
  (Dashboard, Biometrics, Settings).

  WHY THIS FILE EXISTS
  Each of those screens used to carry its own hand-written copy of the bar, and the
  three copies had drifted apart:

    Dashboard   left: 32dp plate + 24dp mascot   right: toggle -> avatar "M"
    Biometrics  left: bare "Biometrics" title    right: toggle only, NO avatar
    Settings    left: 32dp dino image, 2dp pad   right: toggle -> Offline ML pill -> avatar

  Because the right-hand group is laid out from the trailing gutter inwards, every
  extra or missing child shifted the theme toggle sideways. On Settings the
  "Offline ML" pill pushed the toggle ~85dp away from where it sits on Dashboard,
  and Biometrics had no profile picture at all. The mascot had the same problem
  from the other end: 24dp inside a plate on Dashboard, 28dp flat on Settings.

  There is now exactly one bar. The three screens <include> it rather than
  describing it again, so the alignment cannot drift a fourth time: the mascot is
  always at the start of the row and the toggle -> avatar pair is always at the
  end, at the same sizes and the same @dimen/space_sm gap.

  The bar is also the app's voice entry point: Dashboard, Biometrics and Settings all
  show it, so a microphone here is the one button that reaches the voice popup from any
  of the three without each screen growing its own copy.

  ORDER IS PART OF THE CONTRACT (left to right):
    [ mascot plate ][ brand block ][ voice button ][ slack ][ theme toggle ][ profile picture ]
  The left cluster is the only thing that stretches, so it absorbs any difference in
  title length and nothing else moves. Do not insert a child after the toggle.

  The voice button sits AFTER the wordmark on purpose: the left cluster is weighted, so
  a button placed there stays in the top-left corner beside the copy, whereas the same
  button placed after the weighted child would be pushed to the right-hand group and
  read as a sibling of the theme toggle. Its 40dp + 8dp cost is the only width the
  wordmark block lost, which still fits "Offline ML Active" at the largest font scale
  the app supports.

  CALLER CONTRACT
  Bind it with ui/shell/AppHeader.bind(...), which fills in the per-screen subtitle
  text, starts the animated GIF mascot, wires the theme toggle and attaches the voice
  popup to the microphone. A screen that includes this bar without calling it gets no
  subtitle, a single-frame mascot and a microphone that does nothing when tapped.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/appHeader"
    android:layout_width="match_parent"
    android:layout_height="@dimen/header_height"
    android:layout_gravity="top"
    android:background="@drawable/bg_header"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/gutter">

    <!-- ==================== Left: mascot, always first, always the same size ==================== -->
    <FrameLayout
        android:layout_width="@dimen/avatar_size"
        android:layout_height="@dimen/avatar_size"
        android:background="@drawable/bg_zone_pill">

        <!-- Animated GIF. The layout keeps android:src purely so the Android Studio
             preview pane renders something; that path decodes only the first frame,
             so AppHeader loads it through Glide to actually play. -->
        <ImageView
            android:id="@+id/headerDino"
            android:layout_width="@dimen/header_mascot_size"
            android:layout_height="@dimen/header_mascot_size"
            android:layout_gravity="center"
            android:contentDescription="@string/dino_description"
            android:src="@drawable/dino_happy" />
    </FrameLayout>

    <!-- ==================== Left cluster: brand block, then the voice button ====================
         This is the bar's only stretching child, so everything inside it stays pinned to
         the left gutter and the leftover width collects after the voice button. -->
    <LinearLayout
        android:id="@+id/headerLeftCluster"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Brand block: the wordmark over the screen name. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_name"
                    android:textColor="@color/text_primary_dark"
                    android:textStyle="bold" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="@dimen/space_xxs"
                    android:background="@drawable/dot_mint" />
            </LinearLayout>

            <!-- Names the screen, so one bar still tells the three apart.
                 Written by AppHeader.bind. -->
            <TextView
                android:id="@+id/headerSubtitle"
                style="@style/Text.MicroLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Offline ML Active" />
        </LinearLayout>

        <!-- Voice button: opens the Dino voice popup from any of the three screens.
             Same 40dp plate and same 19dp glyph as the theme toggle, so the bar has two
             buttons that were measured once rather than one of each size. Tinted mint
             because it opens a feature, where the toggle is amber to read as a setting.
             The click listener is attached by AppHeader.bind; the button itself is inert. -->
        <FrameLayout
            android:id="@+id/headerVoiceButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_surface_low"
            android:clickable="true"
            android:contentDescription="@string/cd_mic_button"
            android:focusable="true">

            <ImageView
                android:id="@+id/headerVoiceIcon"
                android:layout_width="@dimen/header_toggle_icon"
                android:layout_height="@dimen/header_toggle_icon"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_mic"
                app:tint="@color/brand_mint" />
        </FrameLayout>
    </LinearLayout>

    <!-- ==================== Right: theme toggle, then profile picture ====================
         Nothing may be inserted between these two: the toggle is positioned from
         the trailing edge, so a new child here is exactly what broke the alignment
         before. The Offline ML pill that used to sit in this gap is gone. -->
    <FrameLayout
        android:id="@+id/themeToggleButton"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:background="@drawable/bg_surface_low"
        android:clickable="true"
        android:contentDescription="@string/cd_theme_toggle"
        android:focusable="true">

        <ImageView
            android:id="@+id/themeToggleIcon"
            android:layout_width="@dimen/header_toggle_icon"
            android:layout_height="@dimen/header_toggle_icon"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_light_mode"
            app:tint="@color/accent_amber" />
    </FrameLayout>

    <!-- Profile picture. One identical plate on every screen, per the agreed design.
         The glyph is tinted @color/on_brand rather than @color/bg_dark: bg_dark is
         the app BACKGROUND and flips to near-white in bright mode, which is why the
         old Settings avatar drew a washed-out white person on a mint circle.
         on_brand is deliberately identical in both palettes.

         avatarPhoto is the user's own picture and avatarGlyph is the fallback; they are
         alternatives, never both visible. The photo is match_parent so it fills the plate
         and Glide circle-crops it to the plate's round background. Adding it as a second
         child of a fixed-size FrameLayout cannot move the toggle beside it - the plate is
         @dimen/avatar_size either way, which is what keeps the three screens aligned. -->
    <FrameLayout
        android:id="@+id/avatarBadge"
        android:layout_width="@dimen/avatar_size"
        android:layout_height="@dimen/avatar_size"
        android:layout_marginStart="@dimen/space_sm"
        android:background="@drawable/bg_circle_mint"
        android:contentDescription="@string/cd_brand_avatar">

        <ImageView
            android:id="@+id/avatarPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/cd_profile_photo"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/avatarGlyph"
            android:layout_width="@dimen/header_avatar_icon"
            android:layout_height="@dimen/header_avatar_icon"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_person"
            app:tint="@color/on_brand" />
    </FrameLayout>
</LinearLayout>
