<?xml version="1.0" encoding="utf-8"?>
<!--
  Tone card: HYPE (default selected - android:checked="true")

  Inflated three times with different content by fragment_onboarding.xml via <include>.
  Only the `android:id` differs per include, so the Java can tint the right one.

  MaterialCardView is checkable, so the stroke and fill swap automatically through
  @color/selector_tone_stroke and @color/selector_tone_fill. No Java needed for that part.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:checkable="true"
    android:checked="true"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/touch_target_min"
    app:cardBackgroundColor="@color/selector_tone_fill"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="0dp"
    app:checkedIcon="@null"
    app:rippleColor="@color/brand_mint_glow"
    app:strokeColor="@color/selector_tone_stroke"
    app:strokeWidth="@dimen/stroke_medium">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">

        <!-- Icon plate -->
        <ImageView
            android:id="@+id/toneIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_tone_icon_plate"
            android:contentDescription="@null"
            android:padding="@dimen/space_sm"
            android:src="@drawable/ic_tone_hype"
            app:tint="@color/brand_mint" />

        <!-- Title + tag + description -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/toneTitle"
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tone_hype_title" />

                <TextView
                    android:id="@+id/toneTag"
                    style="@style/Text.MicroLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:background="@drawable/bg_tone_tag"
                    android:paddingHorizontal="@dimen/space_sm"
                    android:paddingVertical="2dp"
                    android:text="@string/tone_hype_tag"
                    android:textColor="@color/brand_mint"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/toneDesc"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tone_hype_desc" />
        </LinearLayout>

        <!-- Radio indicator. Java swaps the background + icon when selection changes. -->
        <FrameLayout
            android:id="@+id/toneIndicator"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_circle_mint">

            <ImageView
                android:id="@+id/toneIndicatorIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_check"
                app:tint="@color/bg_dark" />
        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
