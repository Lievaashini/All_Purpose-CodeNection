<?xml version="1.0" encoding="utf-8"?>
<!-- Outer container for the "Total Committed Load" banner.
     Border colour is swapped in Java as the zone changes. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_container_high" />
    <corners android:radius="@dimen/radius_md" />
    <stroke
        android:width="@dimen/stroke_thin"
        android:color="@color/status_green" />
</shape>
