<?xml version="1.0" encoding="utf-8"?>
<!--
  Open-state row for @id/categorySpinner in sheet_add_task.xml.

  The dropdown would otherwise render dark text on the dark popup background.
  AddTaskSheetFragment's getDropDownView() applies the same colour at runtime.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/touch_target_min"
    android:background="@color/surface_container"
    android:ellipsize="end"
    android:gravity="center_vertical"
    android:maxLines="1"
    android:paddingHorizontal="@dimen/space_md"
    android:textColor="@color/text_primary_dark"
    android:textSize="@dimen/text_body" />
