<?xml version="1.0" encoding="utf-8"?>
<!--
  SCREEN 8 - SETTINGS  (port of Prototype/settings.html)

  The prototype renders only two sections: Appearance and Institutional Data Controls. Its
  other sections are empty containers whose scripts reference deleted elements, so they are
  not reproduced here. The runtime tailwind.config rewrite is replaced by a real night mode
  switch plus a persisted telemetry preference.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <com.example.codenection2026_package.ui.widget.ObservableScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/gutter"
            android:paddingTop="@dimen/content_top_inset"
            android:paddingBottom="@dimen/content_bottom_inset">

            <!-- ============ Profile ============
                 Photo + display name. The name is the SAME preference Screen 2 fills in
                 (OnboardingPrefs "display_name"), so editing it here changes the morning
                 greeting on Daily Harvest rather than creating a second, competing name. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.MicroLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_profile"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Text.MicroLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_profile_hint"
                    android:textColor="@color/brand_mint" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Base"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Preview. avatarPreviewPhoto and avatarPreviewGlyph are
                             alternatives, not layers: SettingsFragment shows the photo
                             when one is stored and the person glyph when it is not. -->
                        <FrameLayout
                            android:layout_width="@dimen/profile_avatar_size"
                            android:layout_height="@dimen/profile_avatar_size"
                            android:background="@drawable/bg_circle_mint">

                            <ImageView
                                android:id="@+id/avatarPreviewPhoto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/cd_profile_photo"
                                android:scaleType="centerCrop"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/avatarPreviewGlyph"
                                android:layout_width="@dimen/avatar_size"
                                android:layout_height="@dimen/avatar_size"
                                android:layout_gravity="center"
                                android:contentDescription="@string/cd_avatar_preview"
                                android:src="@drawable/ic_person"
                                app:tint="@color/on_brand" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.Title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_photo_title" />

                            <TextView
                                style="@style/Text.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/settings_photo_sub" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/changePhotoButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="@dimen/touch_target_min"
                            android:text="@string/settings_change_photo"
                            app:icon="@drawable/ic_person"
                            app:iconGravity="textStart"
                            app:iconTint="@color/brand_mint" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/removePhotoButton"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:minHeight="@dimen/touch_target_min"
                            android:text="@string/settings_remove_photo" />
                    </LinearLayout>

                    <TextView
                        style="@style/Text.MicroLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:text="@string/settings_display_name_label"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/settingsNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/touch_target_min"
                        android:layout_marginTop="@dimen/space_sm"
                        android:background="@drawable/bg_input"
                        android:contentDescription="@string/cd_display_name_input"
                        android:importantForAutofill="no"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:paddingStart="@dimen/space_md"
                        android:paddingEnd="@dimen/space_md"
                        android:textColor="@color/text_primary_dark"
                        android:textColorHint="@color/text_dim_dark"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        style="@style/Text.MicroLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/settings_display_name_hint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Coach tone ============
                 Reuses the Screen 1 tone cards verbatim, so the two screens cannot drift
                 the way the three top bars once did. ToneSelector paints them and writes
                 the choice through OnboardingPrefs.saveTone. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.MicroLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_tone"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Text.MicroLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_tone_hint"
                    android:textColor="@color/brand_mint" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsToneGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical">

                <include
                    android:id="@+id/settingsToneHype"
                    layout="@layout/item_tone_hype" />

                <include
                    android:id="@+id/settingsToneChill"
                    layout="@layout/item_tone_chill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm" />

                <include
                    android:id="@+id/settingsTonePlain"
                    layout="@layout/item_tone_plain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm" />
            </LinearLayout>

            <!-- Immediate feedback for the tap: Screen 1 has the Dino's speech bubble, and
                 this screen has no Dino, so the line the tone produces is shown instead. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_surface_low"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_sm">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_auto_awesome"
                    app:tint="@color/brand_mint" />

                <TextView
                    android:id="@+id/tonePreviewText"
                    style="@style/Text.MicroLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- ============ Appearance ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.MicroLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_appearance"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_palette"
                    app:tint="@color/brand_mint" />

                <TextView
                    style="@style/Text.MicroLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xxs"
                    android:text="@string/settings_appearance_hint"
                    android:textColor="@color/brand_mint" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Base"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <TextView
                        style="@style/Text.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_theme_mode" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_theme_sub" />

                    <!-- Segmented control. Repainted by SettingsFragment.refreshThemeSegment(). -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:background="@drawable/bg_segment_group"
                        android:orientation="horizontal"
                        android:padding="4dp">

                        <LinearLayout
                            android:id="@+id/themeNightButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_segment_on"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:minHeight="@dimen/touch_target_min"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="17dp"
                                android:layout_height="17dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_dark_mode"
                                app:tint="@color/brand_mint" />

                            <TextView
                                android:id="@+id/themeNightLabel"
                                style="@style/Text.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_xs"
                                android:text="@string/settings_theme_night"
                                android:textColor="@color/brand_mint" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/themeBrightButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_xxs"
                            android:layout_weight="1"
                            android:background="@drawable/bg_surface_low"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:minHeight="@dimen/touch_target_min"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="17dp"
                                android:layout_height="17dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_light_mode"
                                app:tint="@color/text_muted_dark" />

                            <TextView
                                android:id="@+id/themeBrightLabel"
                                style="@style/Text.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_xs"
                                android:text="@string/settings_theme_bright"
                                android:textColor="@color/text_muted_dark" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Institutional data controls ============ -->
            <TextView
                style="@style/Text.MicroLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/settings_institutional"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Base"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.Title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_share_title" />

                            <TextView
                                style="@style/Text.MicroLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/settings_share_sub"
                                android:textAllCaps="true" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/telemetrySwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:contentDescription="@string/cd_telemetry_switch" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:background="@drawable/bg_surface_low"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_sm">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_info"
                            app:tint="@color/text_dim_dark" />

                        <TextView
                            style="@style/Text.MicroLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_xs"
                            android:layout_weight="1"
                            android:text="@string/settings_link_info" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_link_status" />

                        <LinearLayout
                            android:id="@+id/linkStatusPill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:background="@drawable/bg_pill_dark"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/space_sm"
                            android:paddingVertical="@dimen/space_xxs">

                            <View
                                android:id="@+id/linkStatusDot"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:background="@drawable/dot_idle" />

                            <TextView
                                android:id="@+id/linkStatusText"
                                style="@style/Text.MicroLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_xxs"
                                android:text="@string/settings_link_disconnected"
                                android:textColor="@color/text_muted_dark" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.example.codenection2026_package.ui.widget.ObservableScrollView>

    <!-- ============ Fixed header ============
         Shared bar. The two things that used to make this screen's bar the odd one
         out are both gone: the mascot was a bare 32dp ImageView with 2dp of internal
         padding (a 28dp sprite) instead of a 24dp sprite centred in a plate, and a
         "Offline ML" pill sat between the theme toggle and the profile picture,
         shoving the toggle ~85dp left of where Dashboard puts it. SettingsFragment
         now names itself through AppHeader.bind. -->
    <include layout="@layout/include_app_header" />

    <include
        android:id="@+id/bottomNavInclude"
        layout="@layout/include_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_gravity="bottom" />
</FrameLayout>


